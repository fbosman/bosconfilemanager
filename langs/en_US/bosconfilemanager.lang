# BosConfilemanager - en_US

#
# Module
#
ModuleBosConfilemanagerName = BosConfilemanager
Module450170Name = BosConfilemanager
Module450170Desc = Explorer for the files of the Dolibarr installation: view, edit, upload and download
BosConfilemanagerName = BosConfilemanager
BosConfilemanagerDescription = Explorer for the files of the Dolibarr installation: view, edit, upload and download
BosConfilemanagerDescriptionLong = Browse all files below the Dolibarr root, view and edit them with syntax highlighting, upload and download files and directories (ZIP), create, rename and delete files and directories. Administrators only. Every change makes a backup first.
BosConfilemanagerMenu = File manager
Permission45017001 = View and download files of the Dolibarr installation
Permission45017002 = Upload, edit, create and rename files and directories
Permission45017003 = Delete files and directories

#
# Setup
#
BosConfilemanagerSetup = BosConfilemanager setup
BosConfilemanagerSetupPage = The file manager always works from the Dolibarr root: <b>%s</b>. Only administrators with the rights of this module can use it.
BOSCONFILEMANAGER_BACKUP_ON_SAVE = Make a backup when saving, overwriting and deleting
BOSCONFILEMANAGER_BACKUP_ON_SAVETooltip = Before a file is saved, overwritten by an upload, restored or deleted, a copy is kept in the documents directory. Backups can be restored from the editor.
BOSCONFILEMANAGER_SHOW_HIDDEN = Show hidden files
BOSCONFILEMANAGER_SHOW_HIDDENTooltip = Files and directories whose name starts with a dot (e.g. .htaccess).
BOSCONFILEMANAGER_PHP_SYNTAX_CHECK = Check PHP syntax when saving
BOSCONFILEMANAGER_PHP_SYNTAX_CHECKTooltip = A PHP file with a syntax error is not saved (unless you confirm). This prevents a typo from taking Dolibarr down.
BOSCONFILEMANAGER_MAX_EDIT_SIZE = Maximum size to edit
BOSCONFILEMANAGER_MAX_EDIT_SIZETooltip = Larger files can only be downloaded.
BOSCONFILEMANAGER_EDITOR_THEME = Editor theme
